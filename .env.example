# Copy this file to .env and fill in every REQUIRED value.
# Names are case-sensitive: use them exactly as written.

# --- Model (REQUIRED) ----------------------------------------------------
# Set ONE of these two keys. MODEL must be a model name your account can use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL=

# --- Tradeverifyd MCP (REQUIRED) -----------------------------------------
TRADEVERIFYD_MCP_URL=https://platform.tradeverifyd.com/api/mcp
TRADEVERIFYD_API_KEY=

# --- Sayari (REQUIRED) ---------------------------------------------------
# API client credentials from Sayari.
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=
SAYARI_AUTH_URL=https://api.sayari.com
# Leave SAYARI_MCP_URL empty to use Sayari's REST API (works with the credentials above).
# Set it to https://mcp.sayari.com/mcp only if Sayari confirms MCP access for your account;
# the MCP server rejects plain API tokens.
SAYARI_MCP_URL=
SAYARI_API_KEY=

# --- Web search for gaps (optional) --------------------------------------
TAVILY_API_KEY=

# --- Geocoding: OpenStreetMap Nominatim (optional, off for now) -----------
# When both are set, Nominatim fills in coordinates the tools and web search didn't provide.
# No sign-up or key. NOMINATIM_EMAIL is just your own email address, which
# Nominatim's usage policy asks for so they can contact you if something goes wrong.
NOMINATIM_EMAIL=
NOMINATIM_URL=

# --- Road distances (optional) -------------------------------------------
# An OSRM routing server. Leave empty to use straight-line distance for road legs.
OSRM_URL=

# --- UK government CO2 conversion factors (optional, off for now) ---------
# To turn on, set to:
# https://www.gov.uk/api/content/government/collections/government-conversion-factors-for-company-reporting
# While empty, CO2 comes only from emissions Tradeverifyd reports.
GOVUK_CONVERSION_FACTORS_COLLECTION=

# --- World Bank (REQUIRED, for country stability) --------------------------
WORLD_BANK_API=https://api.worldbank.org/v2

# --- App -----------------------------------------------------------------
PORT=3000
